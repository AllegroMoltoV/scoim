{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoim.dev/schemas/flow-0.1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "document_id",
    "revision",
    "status",
    "approval",
    "title",
    "overall_flow",
    "instrumentation",
    "target_duration",
    "scenes"
  ],
  "properties": {
    "document_type": {"const": "flow"},
    "schema_version": {"const": "0.1.0"},
    "document_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "approved"]},
    "approval": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["content_sha256"],
          "properties": {
            "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "overall_flow": {"type": "string", "minLength": 1},
    "instrumentation": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "target_duration": {"type": "number", "exclusiveMinimum": 0},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scene"}
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "name",
        "length_class",
        "heard_as",
        "relation_to_previous",
        "transition_to_next"
      ],
      "properties": {
        "scene_id": {"type": "string", "pattern": "^scene-[0-9]{3,}$"},
        "name": {"type": "string", "minLength": 1},
        "length_class": {"enum": ["short", "medium", "long"]},
        "heard_as": {"type": "string", "minLength": 1},
        "relation_to_previous": {"type": "string", "minLength": 1},
        "transition_to_next": {"type": "string", "minLength": 1}
      }
    }
  }
}
