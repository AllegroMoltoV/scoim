{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AllegroMoltoV/scoim/schemas/script-0.1.0.schema.json",
  "title": "SCoIM music script 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "revision",
    "status",
    "approval",
    "script"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "document_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "approved"]},
    "approval": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["content_sha256"],
          "properties": {
            "content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "script": {"$ref": "#/$defs/script"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "nonEmptyText": {"type": "string", "minLength": 1},
    "typedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["section", "material", "placement"]},
        "id": {"$ref": "#/$defs/id"}
      }
    },
    "directionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["section", "placement"]},
        "id": {"$ref": "#/$defs/id"}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_section_id", "order", "role", "description"],
      "properties": {
        "parent_section_id": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]
        },
        "order": {"type": "integer", "minimum": 0},
        "role": {"$ref": "#/$defs/nonEmptyText"},
        "relative_length": {"type": "number", "exclusiveMinimum": 0},
        "description": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": {"$ref": "#/$defs/nonEmptyText"},
        "description": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "material_id"],
      "properties": {
        "section_id": {"$ref": "#/$defs/id"},
        "material_id": {"$ref": "#/$defs/id"}
      }
    },
    "variation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "preserve", "change", "description"],
      "properties": {
        "source": {"$ref": "#/$defs/typedReference"},
        "target": {"$ref": "#/$defs/typedReference"},
        "preserve": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyText"}
        },
        "change": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyText"}
        },
        "description": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_placement_id",
        "connector_placement_id",
        "to_placement_id",
        "description"
      ],
      "properties": {
        "from_placement_id": {"$ref": "#/$defs/id"},
        "connector_placement_id": {"$ref": "#/$defs/id"},
        "to_placement_id": {"$ref": "#/$defs/id"},
        "description": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "performanceDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "description"],
      "properties": {
        "target": {"$ref": "#/$defs/directionTarget"},
        "relative_to": {"$ref": "#/$defs/directionTarget"},
        "description": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performance_direction_id", "feature", "relation"],
      "properties": {
        "performance_direction_id": {"$ref": "#/$defs/id"},
        "feature": {"enum": ["onset_alignment", "loudness"]},
        "relation": {"enum": ["more", "less"]}
      }
    },
    "sectionCollection": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {"$ref": "#/$defs/section"}
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "materialCollection": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {"$ref": "#/$defs/material"}
      },
      "additionalProperties": false
    },
    "placementCollection": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {"$ref": "#/$defs/placement"}
      },
      "additionalProperties": false
    },
    "variationCollection": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {"$ref": "#/$defs/variation"}
      },
      "additionalProperties": false
    },
    "transitionCollection": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {"$ref": "#/$defs/transition"}
      },
      "additionalProperties": false
    },
    "performanceDirectionCollection": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {"$ref": "#/$defs/performanceDirection"}
      },
      "additionalProperties": false
    },
    "requirementCollection": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {"$ref": "#/$defs/requirement"}
      },
      "additionalProperties": false
    },
    "performanceSetup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrumentation",
        "target_duration_seconds",
        "performance_directions"
      ],
      "properties": {
        "instrumentation": {"$ref": "#/$defs/id"},
        "target_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "performance_directions": {
          "$ref": "#/$defs/performanceDirectionCollection"
        }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "brief",
        "performance_setup",
        "root_section_id",
        "sections",
        "materials",
        "placements",
        "variations",
        "transitions"
      ],
      "properties": {
        "title": {"$ref": "#/$defs/nonEmptyText"},
        "brief": {"$ref": "#/$defs/nonEmptyText"},
        "performance_setup": {"$ref": "#/$defs/performanceSetup"},
        "root_section_id": {"$ref": "#/$defs/id"},
        "sections": {"$ref": "#/$defs/sectionCollection"},
        "materials": {"$ref": "#/$defs/materialCollection"},
        "placements": {"$ref": "#/$defs/placementCollection"},
        "variations": {"$ref": "#/$defs/variationCollection"},
        "requirements": {"$ref": "#/$defs/requirementCollection"},
        "transitions": {"$ref": "#/$defs/transitionCollection"}
      }
    }
  }
}
