{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AllegroMoltoV/scoim/schemas/script-0.2.0.schema.json",
  "title": "SCoIM validated music script 0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "document_id",
    "revision",
    "status",
    "source_flow",
    "script"
  ],
  "properties": {
    "document_type": {"const": "script"},
    "schema_version": {"const": "0.2.0"},
    "document_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "revision": {"const": 1},
    "status": {"const": "validated"},
    "source_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "revision", "content_sha256"],
      "properties": {
        "document_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "revision": {"type": "integer", "minimum": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "script": {
      "$ref": "script-0.1.0.schema.json#/$defs/script"
    }
  }
}
